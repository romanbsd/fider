# ALLOW_ALLOWED_SCHEMES=false
# Relaxes the SSRF guard so webhooks and OAuth token/profile URLs may target
# private/internal network addresses (LAN, loopback, link-local). Self-hosted only.
# ALLOW_PRIVATE_NETWORK_TARGETS=true

LOG_LEVEL=DEBUG
LOG_CONSOLE=true
LOG_SQL=true
LOG_FILE=false
LOG_FILE_OUTPUT=logs/output.log

# MAINTENANCE=true
# MAINTENANCE_MESSAGE=Sorry, we're down for scheduled maintenance right now.
# MAINTENANCE_UNTIL=about 5 AM PDT

# Enables the mobile API (cross-origin clients)
# WIDGET_ENABLED=true
# Maximum number of mobile requests per tenant per minute
# WIDGET_RATE_LIMIT=120
# ID token (mobile sign in) provider settings for /widget/signin. When a block
# is set, the endpoint verifies the presented OIDC ID token from that provider
# (signature via JWKS, issuer, audience, expiry) and that its email is verified
# before signing the user in. Google and Apple can be configured at the same
# time; at least one must be fully set for mobile sign-in to be enabled.
# WIDGET_IDTOKEN_GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
# WIDGET_IDTOKEN_GOOGLE_ISSUER=https://accounts.google.com
# WIDGET_IDTOKEN_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# WIDGET_IDTOKEN_APPLE_JWKS_URL=https://appleid.apple.com/auth/keys
# WIDGET_IDTOKEN_APPLE_ISSUER=https://appleid.apple.com
# WIDGET_IDTOKEN_APPLE_APP_ID=com.example.app
# WIDGET_IDTOKEN_APPLE_SERVICES_ID=com.example.app.services

OAUTH_FACEBOOK_APPID=
OAUTH_FACEBOOK_SECRET=

OAUTH_GOOGLE_CLIENTID=
OAUTH_GOOGLE_SECRET=

OAUTH_GITHUB_CLIENTID=
OAUTH_GITHUB_SECRET=

EMAIL_NOREPLY=noreply@yourdomain.com

#EMAIL_MAILGUN_API=
#EMAIL_MAILGUN_DOMAIN=
#EMAIL_MAILGUN_REGION=US

EMAIL_SMTP_HOST=localhost
EMAIL_SMTP_PORT=1025
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
