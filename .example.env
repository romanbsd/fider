# ALLOW_ALLOWED_SCHEMES=false
# Relaxes the SSRF guard so webhooks and OAuth token/profile URLs may target
# private/internal network addresses (LAN, loopback, link-local). Self-hosted only.
# ALLOW_PRIVATE_NETWORK_TARGETS=true

LOG_LEVEL=DEBUG
LOG_CONSOLE=true
LOG_SQL=true
LOG_FILE=false
LOG_FILE_OUTPUT=logs/output.log

# MAINTENANCE=true
# MAINTENANCE_MESSAGE=Sorry, we're down for scheduled maintenance right now.
# MAINTENANCE_UNTIL=about 5 AM PDT

# Enables the feedback widget API
# WIDGET_ENABLED=true
# Maximum number of widget requests per tenant per minute
# WIDGET_RATE_LIMIT=120
# ID token (mobile sign in) provider settings. When set, the widget sign in
# endpoint accepts an id_token issued by this provider and validates it against JWKS.
# WIDGET_IDTOKEN_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
# WIDGET_IDTOKEN_ISSUER=accounts.google.com
# WIDGET_IDTOKEN_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

